# LLM Provider: "gemini", "openai", or "mock" (offline demo/testing)
AQB_PROVIDER=gemini

# API Keys (set the one matching your provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI-compatible base URL (e.g., Ollama, Groq, OpenRouter)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Model Name (defaults: gemini-2.5-flash for gemini, gpt-4o-mini for openai)
AQB_MODEL=gemini-2.5-flash

# Controlled batch sizes (clamped to 10-12 for 2-markers, 5-6 for 13-markers)
AQB_BATCH_SIZE_2M=10
AQB_BATCH_SIZE_13M=5

# Question parsing strategy: "auto", "llm", or "heuristic"
AQB_PARSE_MODE=auto

# Optional critic/fact-check pass on long-answer batches (extra LLM call)
AQB_VERIFY_LONG_ANSWERS=false

# Reliability / retrieval tuning
AQB_MAX_RETRIES=3
AQB_RETRY_BASE_DELAY=2.0
AQB_OUTPUT_DIR=outputs
